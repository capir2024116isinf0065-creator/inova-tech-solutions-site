
---
import LayoutBase from '../layouts/LayoutBase.astro';
import Cartao from '../components/Cartao.astro';
import { empresa } from '../data/empresa.js';
---

<LayoutBase 
	titulo="Início" 
	descricao={`Bem-vindo à ${empresa.nome}. ${empresa.slogan}`}
>
	<section class="hero">
		<div class="container">
			<h1>{empresa.slogan}</h1>
			<p class="hero-descricao">{empresa.missao}</p>
			<a href="/contato" class="btn">Fale Conosco</a>
		</div>
	</section>

	<section class="publico secao secao-alt">
		<div class="container">
			<h2>Quem Atendemos</h2>
			<Cartao>
				<p class="texto-publico">{empresa.publicoAlvo}</p>
			</Cartao>
		</div>
	</section>
</LayoutBase>

<style>
	.hero {
		background: linear-gradient(
			135deg,
			#044FFB 0%,
			#0681FC 45%,
			#08B0FC 100%
		);
		color: #FFFFFF;
		padding: 6rem 0;
		position: relative;
		overflow: hidden;
	}

	.hero h1 {
		color: #FFFFFF;
		font-size: 3rem;
		margin-bottom: 1.5rem;
		line-height: 1.1;
		max-width: 800px;
	}

	.hero-descricao {
		font-size: 1.25rem;
		max-width: 700px;
		margin-bottom: 2rem;
		color: #FFFFFF;
	}

	.hero .btn {
		background: #FFFFFF;
		color: #044FFB;
		border: 2px solid #FFFFFF;
		transition: all 0.3s ease;
	}

	.hero .btn:hover {
		background: #11DBFC;
		color: #044FFB;
		border-color: #11DBFC;
		transform: translateY(-2px);
	}

	.publico {
		background-color: #F0F8FF;
	}

	.publico h2 {
		color: #044FFB;
		margin-bottom: 2rem;
	}

	.texto-publico {
		margin-bottom: 0;
		font-size: 1.125rem;
		color: var(--cor-texto-secundario);
	}

	@media (max-width: 600px) {
		.hero {
			padding: 4rem 0;
		}

		.hero h1 {
			font-size: 2rem;
		}

		.hero-descricao {
			font-size: 1.1rem;
		}
	}
</style>
